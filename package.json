{
  "name": "@qinova-ai/dsh-codex-ui",
  "version": "0.2.7",
  "description": "随 DSH 深浅色配置切换的 Codex 风格界面插件",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./navigation": "./lib/navigation.js",
    "./navigation/locale/*.json": "./locale/navigation/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/test-install.mjs scripts/test-client.mjs scripts/test-skills.mjs scripts/test-navigation.mjs scripts/test-host-signatures.mjs scripts/test-retirement.mjs scripts/test-sidebar-pins.mjs scripts/test-sidebar-recents.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "locale",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "install.cmd",
    "scripts/install.mjs",
    "scripts/rollback.mjs",
    "licenses"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-permission-presets",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QingZzzzzzzzz/dsh-codex-ui.git"
  },
  "homepage": "https://github.com/QingZzzzzzzzz/dsh-codex-ui#readme",
  "bugs": {
    "url": "https://github.com/QingZzzzzzzzz/dsh-codex-ui/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "js-yaml": "4.3.2"
  }
}
